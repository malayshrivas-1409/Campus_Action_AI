# ===== APPLICATION SETTINGS =====
APP_NAME=Campus Action AI
DEBUG=False
LOG_LEVEL=INFO
ENVIRONMENT=development

# ===== SECURITY (CRITICAL - CHANGE FOR PRODUCTION) =====
# Generated automatically if not set, but set explicitly for consistency
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ===== DATABASE =====
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/campus_ai_db

# ===== REDIS (CACHE & QUEUE) =====
REDIS_URL=redis://localhost:6379/0

# ===== GROQ LLM API =====
# Get key from https://console.groq.com
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=mixtral-8x7b-32768

# ===== REQUEST LIMITS =====
MAX_UPLOAD_SIZE_MB=50
MAX_REQUEST_SIZE=10485760
REQUEST_TIMEOUT_SECONDS=30

# ===== RATE LIMITING =====
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_SECONDS=60
